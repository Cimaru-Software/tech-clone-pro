generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  nombre    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Categoria {
  id            String         @id @default(cuid())
  nombre        String         @unique
  slug          String         @unique
  orden         Int            @default(0)
  subcategorias Subcategoria[]
  productos     Producto[]
  createdAt     DateTime       @default(now())
}

model Subcategoria {
  id               String            @id @default(cuid())
  nombre           String
  slug             String            @unique
  orden            Int               @default(0)
  categoriaId      String
  categoria        Categoria         @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  subsubcategorias Subsubcategoria[]
  productos        Producto[]
  createdAt        DateTime          @default(now())
}

model Subsubcategoria {
  id             String       @id @default(cuid())
  nombre         String
  slug           String       @unique
  orden          Int          @default(0)
  subcategoriaId String
  subcategoria   Subcategoria @relation(fields: [subcategoriaId], references: [id], onDelete: Cascade)
  productos      Producto[]
  createdAt      DateTime     @default(now())
}

model Producto {
  id                String           @id @default(cuid())
  nombre            String
  marca             String
  categoriaId       String
  categoria         Categoria        @relation(fields: [categoriaId], references: [id])
  subcategoriaId    String?
  subcategoria      Subcategoria?    @relation(fields: [subcategoriaId], references: [id])
  subsubcategoriaId String?
  subsubcategoria   Subsubcategoria? @relation(fields: [subsubcategoriaId], references: [id])
  descripcion    String           @db.Text
  precio         Decimal          @db.Decimal(10, 2)
  descuento      Int              @default(0)
  // Precio final para pagos por transferencia (opcional). Solo aplica si es menor al precio normal.
  precioTransferencia Decimal?    @db.Decimal(10, 2)
  destacado      Boolean          @default(false)
  imagenes         ProductoImagen[]
  estado           EstadoProducto   @default(ACTIVO)
  stock            Int              @default(0)
  // Contífico
  contificoId      String?          @unique
  contificoCode    String?
  ivaContificoPorc String?          @default("12")
  lastSyncedAt     DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  itemsPedido      ItemPedido[]
  itemsCompra      ItemCompra[]
  seriales         SerialProducto[]
}

model ProductoImagen {
  id         String   @id @default(cuid())
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  path       String
  orden      Int      @default(0)
  createdAt  DateTime @default(now())
}

model BannerHero {
  id        String   @id @default(cuid())
  path      String
  orden     Int      @default(0)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banners_hero")
}

model Noticia {
  id        String   @id @default(cuid())
  titulo    String
  slug      String   @unique
  portada   String
  cuerpo    String   @db.Text
  publicado Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("noticias")
}

model BannerPromocion {
  id        String   @id @default(cuid())
  path      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banner_promocion")
}

model ConfiguracionIva {
  id         String   @id @default(cuid())
  porcentaje Float    @default(15)
  updatedAt  DateTime @updatedAt

  @@map("configuracion_iva")
}

model EnvioProvincia {
  id        String   @id @default(cuid())
  provincia String   @unique
  costo     Float    @default(0)
  updatedAt DateTime @updatedAt

  @@map("envio_provincia")
}

model Certificado {
  id        String   @id @default(cuid())
  nombre    String
  path      String
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("certificados")
}

enum EstadoProducto {
  ACTIVO
  INACTIVO
}

model Cliente {
  id                String              @id @default(cuid())
  nombre            String
  apellido          String
  email             String              @unique
  password          String
  telefono          String?
  direccion         String?
  ciudad            String?
  pedidos           Pedido[]
  compras           Compra[]
  resetTokens       PasswordResetToken[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

model Pedido {
  id         String       @id @default(cuid())
  clienteId  String
  cliente    Cliente      @relation(fields: [clienteId], references: [id])
  total      Decimal      @db.Decimal(10, 2)
  estado     EstadoPedido @default(PENDIENTE)
  metodoPago String
  direccion  String
  ciudad     String
  provincia  String       @default("")
  notas      String?      @db.Text
  items      ItemPedido[]
  compraId   String?      @unique
  compra     Compra?      @relation(fields: [compraId], references: [id])
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model ItemPedido {
  id         String   @id @default(cuid())
  pedidoId   String
  pedido     Pedido   @relation(fields: [pedidoId], references: [id])
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])
  cantidad   Int
  precio     Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
}

enum EstadoPedido {
  PENDIENTE
  PROCESANDO
  ENVIADO
  ENTREGADO
  CANCELADO
  ANULADO
}

model Compra {
  id              String       @id @default(cuid())
  clienteId       String
  cliente         Cliente      @relation(fields: [clienteId], references: [id])
  pedido          Pedido?
  total           Decimal      @db.Decimal(10, 2)
  estado          EstadoCompra @default(PENDIENTE)
  metodoPago      String
  direccion       String
  ciudad          String
  provincia       String       @default("")
  notas           String?      @db.Text
  comprobantePath  String?
  pluxTransaccion  String?
  pluxToken        String?
  motivoRechazo    String?          @db.Text
  facturaTipoIdentificacion String?
  facturaIdentificacion     String?
  facturaRazonSocial        String?
  facturaEmail              String?
  facturaTelefono           String?
  facturaDireccion          String?
  items           ItemCompra[]
  facturaContifico ContificoFactura?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model ItemCompra {
  id         String          @id @default(cuid())
  compraId   String
  compra     Compra          @relation(fields: [compraId], references: [id], onDelete: Cascade)
  productoId String
  producto   Producto        @relation(fields: [productoId], references: [id])
  cantidad   Int
  precio     Decimal         @db.Decimal(10, 2)
  createdAt  DateTime        @default(now())
  seriales   SerialProducto[]
}

model SerialProducto {
  id                 String   @id @default(cuid())
  serial             String
  contificoProductoId String
  productoId         String
  producto           Producto @relation(fields: [productoId], references: [id])
  estado             String   @default("disponible") // "disponible" | "vendido"
  itemCompraId       String?
  itemCompra         ItemCompra? @relation(fields: [itemCompraId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([contificoProductoId, serial])
  @@map("seriales_producto")
}

enum EstadoCompra {
  PENDIENTE
  APROBADO
  RECHAZADO
}

model ContificoSyncLog {
  id            String   @id @default(cuid())
  tipo          String   // "productos" | "stock" | "factura"
  estado        String   // "ok" | "error"
  mensaje       String?  @db.Text
  detalle       String?  @db.Text
  compraId      String?
  createdAt     DateTime @default(now())

  @@map("contifico_sync_logs")
}

model ContificoFactura {
  id                String   @id @default(cuid())
  compraId          String   @unique
  compra            Compra   @relation(fields: [compraId], references: [id])
  contificoDocId    String
  contificoSecuencial String?
  estado            String   @default("emitida")
  createdAt         DateTime @default(now())

  @@map("contifico_facturas")
}
